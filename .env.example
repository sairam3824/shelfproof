# ---------------------------------------------------------------- database
# DATABASE_URL is the pooled connection (used by the web app).
# DIRECT_URL is the direct connection (used by `prisma db push`).
# On a plain Postgres server these are the same URL twice; on Neon they differ.
# See torun.txt sections 2-3 for full setup.

# Local PostgreSQL (macOS + Homebrew) — replace `youruser` with your username:
DATABASE_URL="postgresql://youruser@localhost:5432/shelfproof"
DIRECT_URL="postgresql://youruser@localhost:5432/shelfproof"

# Neon (hosted) — use the pooled URL first, the direct URL second:
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/shelfproof?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/shelfproof?sslmode=require"

# ------------------------------------------------------------------- agent
# Needed by the runner (`npm run trials`) only — the dashboard never calls the
# LLM. Sonnet 4.6 is used because it still accepts `temperature`, which the
# experiment design requires: 8 trials per cell are only independent draws if
# the model can vary its answer. Opus 5 removed temperature/top_p/top_k
# outright (400); Sonnet 5 rejects any non-default value. The runner refuses
# such a model at startup rather than failing all 240 calls.
ANTHROPIC_API_KEY="sk-ant-..."
SHELFPROOF_MODEL="claude-sonnet-4-6"
SHELFPROOF_TEMPERATURE="0.7"
