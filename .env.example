# Neon Postgres. DATABASE_URL is the pooled connection (used by the web app),
# DIRECT_URL is the direct connection (used by `prisma db push` / migrations).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/shelfproof?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/shelfproof?sslmode=require"

# Agent. Sonnet 4.6 is used because it still accepts `temperature`, which the
# experiment design requires. Opus 5 removed temperature/top_p/top_k outright
# (400); Sonnet 5 rejects any non-default value.
ANTHROPIC_API_KEY="sk-ant-..."
SHELFPROOF_MODEL="claude-sonnet-4-6"
SHELFPROOF_TEMPERATURE="0.7"
