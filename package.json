{
  "name": "shelfproof",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "An experiment bench that measures which product-listing edits make an AI shopping assistant recommend a given SKU.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "trials": "node --env-file=.env scripts/run-trials.ts",
    "report": "node --env-file=.env scripts/report.ts",
    "test": "node --test --env-file-if-exists=.env src/lib/*.test.ts"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@prisma/client": "^6.19.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.0"
  }
}
